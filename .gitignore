.vs/
CHCT/bin/
CHCT/obj/
*.user
*.vspx
*.psess
*.suo

# ── Web（Node / Vite）──
web/node_modules/
web/dist/
web/public/data/*.sqlite
# HanaMin 字型（GlyphWiki 授權，數十 MB；由 `npm run setup-fonts` 取得）
web/public/fonts/

