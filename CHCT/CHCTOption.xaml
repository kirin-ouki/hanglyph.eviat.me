<Window x:Class="CHCT.CHCTOption"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CHCT"        
        mc:Ignorable="d"
        Title="設定" Height="433" Width="628" ResizeMode="NoResize" FontSize="15">
    <Window.Resources>
        <local:CharDataSet x:Key="charDataSet"/>
        <CollectionViewSource x:Key="partCViewSource"    Source="{Binding PartC,    Source={StaticResource charDataSet}}"/>
        <CollectionViewSource x:Key="charXViewSource"    Source="{Binding CharX,    Source={StaticResource charDataSet}}"/>
        <CollectionViewSource x:Key="phoenicsViewSource" Source="{Binding Phoenics, Source={StaticResource charDataSet}}"/>
    </Window.Resources>
    <Grid>
        <Grid Margin="10,10,10,38" >
            <TabControl x:Name="Settings" TabStripPlacement="Left" Margin="0,0,0,10" SelectionChanged="Settings_SelectionChanged">
                <TabItem x:Name="NormalSettings" Header="一般設定">
                    <ScrollViewer Width="Auto">
                        <Grid Height="Auto">
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <Expander x:Name="NormalSettingsFontsExpander" Header="字型" Grid.Row="0" Height="Auto" IsExpanded="True">
                                <Grid Margin="24,0,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <Expander Grid.Row="0" Header="一般字型" IsExpanded="True">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition/>
                                            </Grid.ColumnDefinitions>
                                            <ComboBox x:Name="ComboRegularFont" IsEditable="True" IsReadOnly="True" Text="新細明體"/>
                                            <TextBox  x:Name="ComboRegularFontTB" Grid.Column="1" Text="這裡是測試用字" TextAlignment="Center" FontFamily="{Binding Text, ElementName=ComboRegularFont}" FontSize="24"/>
                                        </Grid>
                                    </Expander>
                                    <Expander Grid.Row="1" Header="字元區字型" IsExpanded="True">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition/>
                                            </Grid.ColumnDefinitions>
                                            <ComboBox x:Name="ComboCharBlockFont" SelectionChanged="ComboCharBlockFont_SelectionChanged" IsEditable="True" IsReadOnly="True" Text="新細明體"/>
                                            <TextBox  x:Name="ComboCharBlockFontTB" Grid.Column="1" Text="這裡是測試用字" TextAlignment="Center" FontFamily="{Binding Text, ElementName=ComboCharBlockFont}" FontSize="24"/>
                                        </Grid>
                                    </Expander>
                                    <Expander Grid.Row="2" Header="篩選區標題字型" IsExpanded="True">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition/>
                                            </Grid.ColumnDefinitions>
                                            <ComboBox x:Name="ComboFilterFont" SelectionChanged="ComboFilterFont_SelectionChanged" IsEditable="True" IsReadOnly="True" Text="新細明體"/>
                                            <TextBox  x:Name="ComboFilterFontTB" Grid.Column="1" Text="這裡是測試用字" TextAlignment="Center" FontFamily="{Binding Text, ElementName=ComboFilterFont}" FontSize="24"/>
                                        </Grid>
                                    </Expander>
                                    <Expander Grid.Row="3" Header="篩選區按鈕字型" IsExpanded="True">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition/>
                                            </Grid.ColumnDefinitions>
                                            <ComboBox x:Name="ComboFilterBtnFont" SelectionChanged="ComboFilterBtnFont_SelectionChanged" IsEditable="True" IsReadOnly="True" Text="新細明體"/>
                                            <TextBox  x:Name="ComboFilterBtnFontTB" Grid.Column="1" Text="這裡是測試用字" TextAlignment="Center" FontFamily="{Binding Text, ElementName=ComboFilterBtnFont}" FontSize="24"/>
                                        </Grid>
                                    </Expander>
                                    <Expander Grid.Row="4" Header="字元拆分區字型" IsExpanded="True">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition/>
                                            </Grid.ColumnDefinitions>
                                            <ComboBox x:Name="ComboPartFont" SelectionChanged="ComboPartFont_SelectionChanged" IsEditable="True" IsReadOnly="True" Text="新細明體"/>
                                            <TextBox  x:Name="ComboPartFontTB" Grid.Column="1" Text="這裡是測試用字" TextAlignment="Center" FontFamily="{Binding Text, ElementName=ComboPartFont}" FontSize="24"/>
                                        </Grid>
                                    </Expander>
                                </Grid>
                            </Expander>
                            <Expander x:Name="NormalSettingsPhoenicsExpander" Header="標音" Grid.Row="1" IsExpanded="True">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3*"/>
                                        <ColumnDefinition Width="5*"/>
                                        <ColumnDefinition Width="6*"/>
                                        <ColumnDefinition Width="1*"/>
                                    </Grid.ColumnDefinitions>
                                    <Label Grid.Row="0" Grid.Column="0" Content="標音選項" Background="Linen" HorizontalContentAlignment="Center"></Label>
                                    <Label Grid.Row="0" Grid.Column="1" Content="標音系統" Background="Linen" HorizontalContentAlignment="Center"></Label>
                                    <Label Grid.Row="0" Grid.Column="2" Content="背景顏色" Background="Linen" HorizontalContentAlignment="Center"></Label>
                                    <Label Grid.Row="0" Grid.Column="3" Content=""        Background="Linen" HorizontalContentAlignment="Center"></Label>
                                    <Label Grid.Row="1" Grid.Column="0" Content="選用標音1"></Label>
                                    <Label Grid.Row="2" Grid.Column="0" Content="選用標音2"></Label>
                                    <Label Grid.Row="3" Grid.Column="0" Content="選用標音3"></Label>
                                    <ComboBox x:Name="PhoenicsPart1" Grid.Row="1" Grid.Column="1" Tag="1" IsEditable="True" IsReadOnly="True" Text="無" SelectionChanged="PhoenicsPart_SelectionChanged"></ComboBox>
                                    <ComboBox x:Name="PhoenicsPart2" Grid.Row="2" Grid.Column="1" Tag="2" IsEditable="True" IsReadOnly="True" Text="無" SelectionChanged="PhoenicsPart_SelectionChanged"></ComboBox>
                                    <ComboBox x:Name="PhoenicsPart3" Grid.Row="3" Grid.Column="1" Tag="3" IsEditable="True" IsReadOnly="True" Text="無" SelectionChanged="PhoenicsPart_SelectionChanged"></ComboBox>
                                    <ComboBox x:Name="PhoenicsBGPart1"  Grid.Row="1" Grid.Column="2" Tag="1" IsEditable="True" IsReadOnly="True" SelectionChanged="PhoenicsBGPart_SelectionChanged"></ComboBox>
                                    <ComboBox x:Name="PhoenicsBGPart2"  Grid.Row="2" Grid.Column="2" Tag="2" IsEditable="True" IsReadOnly="True" SelectionChanged="PhoenicsBGPart_SelectionChanged"></ComboBox>
                                    <ComboBox x:Name="PhoenicsBGPart3"  Grid.Row="3" Grid.Column="2" Tag="3" IsEditable="True" IsReadOnly="True" SelectionChanged="PhoenicsBGPart_SelectionChanged"></ComboBox>
                                    <Label x:Name="PhoenicsLBPart1" Grid.Row="1" Grid.Column="3" Content="" Tag="1"></Label>
                                    <Label x:Name="PhoenicsLBPart2" Grid.Row="2" Grid.Column="3" Content="" Tag="2"></Label>
                                    <Label x:Name="PhoenicsLBPart3" Grid.Row="3" Grid.Column="3" Content="" Tag="3"></Label>
                                </Grid>
                                
                            </Expander>
                        </Grid>
                    </ScrollViewer>
                </TabItem>
                <TabItem x:Name="PTSettings" Header="部件設定">
                    <ScrollViewer Width="Auto">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <Expander Header="自定義部件" Grid.Row="0" IsExpanded="True">
                                <Grid Margin="0,0,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <Expander Grid.Column="0" Header="輸入部件" Margin="24,0,0,0" IsExpanded="True">
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="3*"/>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="4*"/>
                                                <ColumnDefinition Width="8*"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBox x:Name="PTCustomInput" Grid.Column="0" TextChanged="PTCustomInput_TextChanged"></TextBox>
                                            <TextBox x:Name="PTCustomSTKT"  Grid.Column="1" IsEnabled="false"></TextBox>
                                            <Button  x:Name="PTCustomApply" Grid.Column="2" Content="確定輸入"  Click="PTCustomApply_Click" IsEnabled="False"></Button>
                                        </Grid>
                                    </Expander>
                                    <Grid Grid.Row="1" Margin="24,0,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <Expander Grid.Row="0" Header="已輸入部件" Background="Azure" IsExpanded="True"></Expander>
                                        <WrapPanel x:Name="PTCustomPanel" Grid.Row="1" MaxHeight="240" Height="52" Background="Azure"/>


                                    </Grid>
                                    <Grid Margin="24,0,0,0" Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="PTCustomDelete" Grid.Column="0" Content="刪除所選部件" Click="PTCustomDelete_Click"></Button>
                                        <Button x:Name="PTCustomModify" Grid.Column="1" Content="修改所選部件" Click="PTCustomModify_Click" IsEnabled="False"></Button>
                                        <Button x:Name="PTCustomCheck" Grid.Column="2" Content="檢測重複部件" Click="PTCustomCheck_Click" IsEnabled="False"></Button>
                                    </Grid>
                                </Grid>
                            </Expander>
                            <Expander Header="一般部件選項" Grid.Row="1" MaxHeight="240" IsExpanded="True">
                                <Grid x:Name="OptionPTCustomGrid" Margin="24,0,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <Expander Header="顯示" IsExpanded="True"></Expander>
                                    <RadioButton x:Name="OptionPTCustomGridMost" Grid.Row="1" Content="只顯示最常用部件(不適用)" Checked="OptionPTCustomGridRegular_Checked" IsEnabled="False"/>
                                    <RadioButton x:Name="OptionPTCustomGridRegular" Grid.Row="2" Content="只顯示常用部件" IsChecked="True" Checked="OptionPTCustomGridRegular_Checked"></RadioButton>
                                    <RadioButton x:Name="OptionPTCustomGridAll" Grid.Row="3" Content="顯示所有部件"  Checked="OptionPTCustomGridAll_Checked"></RadioButton>
                                </Grid>
                            </Expander>
                        </Grid>

                    </ScrollViewer>
                </TabItem>
                <TabItem Header="尺度與規準">
                    <ScrollViewer  Width="Auto">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <Expander Header="篩選區版面" Grid.Row="0" IsExpanded="True">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition Height="29"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="3*"/>
                                        <ColumnDefinition Width="1*"/>
                                    </Grid.ColumnDefinitions>
                                    <Label Content="標題標籤大小" Grid.Row="0" Margin="24,0,0,0"></Label>
                                    <Label Content="字元按鈕大小" Grid.Row="1" Margin="24,0,0,0"></Label>
                                    <Label Content="清除按鈕大小" Grid.Row="2" Margin="24,0,0,0"></Label>
                                    <Slider  x:Name="FontSizeFilterTitleSlider" Grid.Row="0" Grid.Column="1" Margin="0,6,0,0" IsSnapToTickEnabled="True" Minimum="20" Maximum="60" ValueChanged="FilterChrSizeSlider_ValueChanged"/>
                                    <Slider  x:Name="FontSizeFilterCharBtnSlider" Grid.Row="1" Grid.Column="1" Margin="0,6,0,0" IsSnapToTickEnabled="True" Minimum="24" Maximum="60" ValueChanged="FilterBtnSizeSlider_ValueChanged"/>
                                    <Slider  x:Name="FontSizeFilterClrBtnSlider" Grid.Row="2" Grid.Column="1" Margin="0,6,0,0" IsSnapToTickEnabled="True" Minimum="16" Maximum="48" ValueChanged="FilterClrSizeSlider_ValueChanged"/>
                                    <TextBox x:Name="FontSizeFilterTitleTB" Grid.Row="0" Grid.Column="2" Text="{Binding Value, ElementName=FontSizeFilterTitleSlider, Mode=TwoWay}"/>
                                    <TextBox x:Name="FontSizeFilterCharBtnTB" Grid.Row="1" Grid.Column="2" Text="{Binding Value, ElementName=FontSizeFilterCharBtnSlider, Mode=TwoWay}"/>
                                    <TextBox x:Name="FontSizeFilterClrBtnTB" Grid.Row="2" Grid.Column="2" Text="{Binding Value, ElementName=FontSizeFilterClrBtnSlider, Mode=TwoWay}"/>
                                </Grid>
                            </Expander>
                            <Expander Header="選字區版面" Grid.Row="1" IsExpanded="True">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="3*"/>
                                        <ColumnDefinition Width="1*"/>
                                    </Grid.ColumnDefinitions>
                                    <Label Content="按鈕大小" Grid.Row="0" Margin="24,0,0,0"></Label>
                                    <Slider x:Name="FontSizeCharBlockSlider" Grid.Row="0" Grid.Column="1" Margin="0,6,0,0" IsSnapToTickEnabled="True" Minimum="40" Maximum="80" ValueChanged="CharBlockBtnSizeSlider_ValueChanged"/>
                                    <TextBox x:Name="FontSizeCharBlockTB" Grid.Row="0" Grid.Column="2" Text="{Binding Value, ElementName=FontSizeCharBlockSlider, Mode=TwoWay}"/>
                                </Grid>
                            </Expander>
                            <Expander Header="輸出區版面" Grid.Row="2" IsExpanded="True">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="3*"/>
                                        <ColumnDefinition Width="1*"/>
                                    </Grid.ColumnDefinitions>
                                    <Label Content="字體大小" Grid.Row="0" Margin="24,0,0,0"></Label>
                                    <Slider x:Name="OutputFontSizeSlider" Grid.Row="0" Grid.Column="1" Margin="0,6,0,0" IsSnapToTickEnabled="True" Minimum="32" Maximum="72" ValueChanged="OutputFontSizeSlider_ValueChanged"/>
                                    <TextBox x:Name="OutputFontSizeTB" Grid.Row="0" Grid.Column="2" Text="{Binding Value, ElementName=OutputFontSizeSlider, Mode=TwoWay}"/>
                                </Grid>
                            </Expander>
                        </Grid>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="介面色調" >
                    
                    <ScrollViewer Width="Auto">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <Expander x:Name="Options"  Header="基本資料區" Grid.Row="0">
                                
                            </Expander>
                            <Expander Header="核心功能區" Grid.Row="1" IsExpanded="True">
                                <Grid Margin="24,0,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <Expander Header="進階資料區" Grid.Row="0"></Expander>
                                    <Expander Header="搜尋區" Grid.Row="1" IsExpanded="True">
                                        <Grid Margin="24,0,0,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition/>
                                                <RowDefinition/>
                                            </Grid.RowDefinitions>
                                            <Expander Header="篩選區" Grid.Row="0"></Expander>
                                            <Expander Header="字元區" Grid.Row="1" IsExpanded="True">
                                                <Grid Margin="24,0,0,0">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition/>
                                                        <RowDefinition/>
                                                    </Grid.RowDefinitions>
                                                    <Expander Header="字元方盤區" Grid.Row="0"></Expander>
                                                    <Expander Header="字元操作區" Grid.Row="1"></Expander>
                                                </Grid>
                                            </Expander>
                                        </Grid>
                                    </Expander>
                                    <Expander Header="輸出區" Grid.Row="2"></Expander>
                                </Grid>
                            </Expander>
                            
                        </Grid>
                    </ScrollViewer>
                </TabItem>
                <TabItem x:Name="PutputSettings" Header="輸出">
                    <ScrollViewer>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <Expander Header="字元區輸出" IsExpanded="True">
                                <Grid Margin="24,0,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <Expander Grid.Row="0" Header="輸出源範圍" IsExpanded="True">
                                        <Grid Margin="24,0,0,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition/>
                                                <RowDefinition/>
                                            </Grid.RowDefinitions>
                                            <RadioButton x:Name="OutputOnlyThePage" Grid.Row="0" Content="只有該頁面" Checked="OutputOnlyThePage_Checked"/>
                                            <RadioButton x:Name="OutputAllPages" Grid.Row="1" Content="所有頁面" IsChecked="True" Checked="OutputAllPages_Checked"/>
                                        </Grid>
                                    </Expander>
                                    <Expander Grid.Row="1" Header="分隔符號" IsExpanded="True">
                                        <Grid Margin="24,0,0,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition/>
                                                <RowDefinition/>
                                                <RowDefinition/>
                                                <RowDefinition/>
                                            </Grid.RowDefinitions>
                                            <RadioButton x:Name="OutputSeparateNone"  Grid.Row="0" Content="無" IsChecked="True" Checked="OutputSeparateNone_Checked"/>
                                            <RadioButton x:Name="OutputSeparateWith" Grid.Row="1" Content="使用" Checked="OutputSeparateWith_Checked"/>
                                            <TextBox     x:Name="OutputSeparateChar" Grid.Row="1" Text="" Margin="57,0,298,0" TextChanged="OutputSeparateChar_TextChanged" />
                                            <Label       Grid.Row="2" Content="可以使用特殊符號如'\n'或'\r'等" IsEnabled="False"/>
                                        </Grid>
                                    </Expander>
                                    <Expander Grid.Row="2" Header="字型支援過濾" IsExpanded="True" IsEnabled="False">
                                        <Grid Margin="24,0,0,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition/>
                                                <RowDefinition/>
                                            </Grid.RowDefinitions>
                                            <RadioButton x:Name="OutputFontSupportedNone"  Grid.Row="0" Content="無" IsChecked="True" Checked="OutputFontSupportedNone_Checked"/>
                                            <RadioButton x:Name="OutputFontSupported"      Grid.Row="1" Content="開啟" Checked="OutputFontSupported_Checked"/>
                                        </Grid>
                                    </Expander>
                                </Grid>
                            </Expander>
                        </Grid>
                    </ScrollViewer>
                </TabItem>
                
                <TabItem Header="其他" IsEnabled="True">
                    <ScrollViewer>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <Expander Header="偵錯" IsExpanded="True">
                                <Grid Margin="24,0,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <CheckBox x:Name="DebugModeEnabled" Grid.Row="0" Content="開啟偵錯模式"/>
                                    <Label Grid.Row="1" Content="●●●注意：開啟偵錯模式可能會導致無法預期的錯誤！●●●"></Label>
                                </Grid>
                            </Expander>
                        </Grid>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>
        <Button x:Name="Default" Content="(_D)預設" HorizontalAlignment="Left" Margin="137,0,0,15" VerticalAlignment="Bottom" Width="75"/>
        <Button x:Name="Apply"   Content="(_A)套用" HorizontalAlignment="Left" Margin="217,0,0,15" VerticalAlignment="Bottom" Width="75" Click="Apply_Click"/>
        <Button x:Name="OK"      Content="(_K)確定" HorizontalAlignment="Left" Margin="297,0,0,15" VerticalAlignment="Bottom" Width="75" Click="OK_Click"/>
        <Button x:Name="Cancel"  Content="(_C)取消" HorizontalAlignment="Left" Margin="377,0,0,15" VerticalAlignment="Bottom" Width="75"/>

    </Grid>
</Window>
