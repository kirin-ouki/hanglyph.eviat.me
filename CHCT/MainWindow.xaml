<Window x:Class="CHCT.MainWindow"
        x:Name="CHCTMainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CHCT"
        mc:Ignorable="d"
        Title="字元查詢系統(W10 Ver.)" Height="749" Width="800" MinHeight="540" MinWidth="800" Loaded="Window_Loaded" Closed="Window_Closed">
    <Window.Resources>
        <local:CharDataSet x:Key="charDataSet"/>
        <CollectionViewSource x:Key="charXViewSource" Source="{Binding CharX, Source={StaticResource charDataSet}}"/>
        <CollectionViewSource x:Key="partBViewSource" Source="{Binding PartB, Source={StaticResource charDataSet}}"/>
        <CollectionViewSource x:Key="partCViewSource" Source="{Binding PartC, Source={StaticResource charDataSet}}"/>
        <CollectionViewSource x:Key="partKViewSource" Source="{Binding PartK, Source={StaticResource charDataSet}}"/>
        <CollectionViewSource x:Key="phoenicsViewSource" Source="{Binding Phoenics, Source={StaticResource charDataSet}}"/>
    </Window.Resources>

    <Grid Margin="0,0,2,0">
        <TabControl x:Name="TabControlChar" Margin="165,33,10,104">
            <TabItem x:Name="TabItemCharExtendedInfo" Header="字元進階資料" FontSize="15">
                <Grid Background="#FFE5E5E5">
                    <Grid x:Name="Grid8" DataContext="{StaticResource charXViewSource}" Margin="0,0,171,0" VerticalAlignment="Top" Height="87">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="78"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1*"/>
                            <RowDefinition Height="1*"/>
                            <RowDefinition Height="1*"/>
                        </Grid.RowDefinitions>
                        <Label Grid.Column="0" Grid.Row="0" Content="康熙集部"  Margin="3,0,0,0"></Label>
                        <TextBox x:Name="C_KXCTextBox" Grid.Column="1" Grid.Row="0" IsReadOnly="True" Text="{Binding C_KXC, Mode=TwoWay, NotifyOnValidationError=true, ValidatesOnExceptions=true}" VerticalAlignment="Center" FontSize="18" Margin="0,2"/>
                        <Label Grid.Column="0" Grid.Row="1" Content="部件" Margin="3,0,0,0"></Label>
                        <TextBox x:Name="C_PTTextBox"  Grid.Column="1" Grid.Row="1" IsReadOnly="True" Text="{Binding C_PT, Mode=TwoWay, NotifyOnValidationError=true, ValidatesOnExceptions=true}" VerticalAlignment="Center" FontSize="18" Margin="0,2"/>
                        <Label Grid.Column="0" Grid.Row="2" Content="字元區" Margin="3,0,0,0"></Label>
                        <TextBox x:Name="C_CZTextBox"  Grid.Column="1" Grid.Row="2" IsReadOnly="True" FontSize="18" Margin="0,2,0,0" VerticalAlignment="Top"/>

                    </Grid>
                    <TextBox x:Name="C_CMTTextBox" DataContext="{StaticResource charXViewSource}" TextWrapping="Wrap" Margin="7,92,171,10" Grid.Row="0" Text="{Binding C_CMT, Mode=TwoWay, NotifyOnValidationError=true, ValidatesOnExceptions=true}" FontSize="18"/>
                    <Grid x:Name="PhoenicsOuterGrid" Margin="0,10,10,10" HorizontalAlignment="Right" Width="156">
                        <ScrollViewer>
                            <Grid x:Name="PhoenicsInnerGrid">
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <Expander x:Name="PhoenicsPartialExpander0" Header="注音" Grid.Row="0" Margin="8,0,0,0" Height="Auto" VerticalAlignment="Top" HorizontalAlignment="Left" Width="120" FontSize="15" IsExpanded="True">
                                    <Grid x:Name="PhoenicsPartialGrid0" Height="120" DataContext="{StaticResource charXViewSource}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="1*"/>
                                            <RowDefinition Height="1*"/>
                                            <RowDefinition Height="1*"/>
                                            <RowDefinition Height="1*"/>
                                            <RowDefinition Height="1*"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="1*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="TBPH1"  Background="Ivory" Text="{Binding C_PH1,  Mode=TwoWay, NotifyOnValidationError=true, ValidatesOnExceptions=true}" Grid.Row="0" IsReadOnly="True" TextChanged="TBPH_TextChanged"/>
                                        <TextBox x:Name="TBPH2"  Background="Ivory" Text="{Binding C_PH2,  Mode=TwoWay, NotifyOnValidationError=true, ValidatesOnExceptions=true}" Grid.Row="1" IsReadOnly="True" TextChanged="TBPH_TextChanged"/>
                                        <TextBox x:Name="TBPH3"  Background="Ivory" Text="{Binding C_PH3,  Mode=TwoWay, NotifyOnValidationError=true, ValidatesOnExceptions=true}" Grid.Row="2" IsReadOnly="True" TextChanged="TBPH_TextChanged"/>
                                        <TextBox x:Name="TBPH4"  Background="Ivory" Text="{Binding C_PH4,  Mode=TwoWay, NotifyOnValidationError=true, ValidatesOnExceptions=true}" Grid.Row="3" IsReadOnly="True" TextChanged="TBPH_TextChanged"/>
                                        <TextBox x:Name="TBPH5"  Background="Ivory" Text="{Binding C_PH5,  Mode=TwoWay, NotifyOnValidationError=true, ValidatesOnExceptions=true}" Grid.Row="4" IsReadOnly="True" TextChanged="TBPH_TextChanged"/>
                                        <TextBox x:Name="TBPH6"  Background="Ivory" Text="{Binding C_PH6,  Mode=TwoWay, NotifyOnValidationError=true, ValidatesOnExceptions=true}" Grid.Row="0" IsReadOnly="True" Grid.Column="1" TextChanged="TBPH_TextChanged"/>
                                        <TextBox x:Name="TBPH7"  Background="Ivory" Text="{Binding C_PH7,  Mode=TwoWay, NotifyOnValidationError=true, ValidatesOnExceptions=true}" Grid.Row="1" IsReadOnly="True" Grid.Column="1" TextChanged="TBPH_TextChanged"/>
                                        <TextBox x:Name="TBPH8"  Background="Ivory" Text="{Binding C_PH8,  Mode=TwoWay, NotifyOnValidationError=true, ValidatesOnExceptions=true}" Grid.Row="2" IsReadOnly="True" Grid.Column="1" TextChanged="TBPH_TextChanged"/>
                                        <TextBox x:Name="TBPH9"  Background="Ivory" Text="{Binding C_PH9,  Mode=TwoWay, NotifyOnValidationError=true, ValidatesOnExceptions=true}" Grid.Row="3" IsReadOnly="True" Grid.Column="1" TextChanged="TBPH_TextChanged"/>
                                        <TextBox x:Name="TBPH10" Background="Ivory" Text="{Binding C_PH10, Mode=TwoWay, NotifyOnValidationError=true, ValidatesOnExceptions=true}" Grid.Row="4" IsReadOnly="True" Grid.Column="1" TextChanged="TBPH_TextChanged"/>
                                    </Grid>
                                </Expander>
                                <Expander x:Name="PhoenicsPartialExpander1" Grid.Row="1" Header="其他標音1" Tag="1" Margin="8,0,0,0" Height="Auto" Visibility="Hidden" VerticalAlignment="Top" HorizontalAlignment="Left" Width="120" FontSize="15">
                                    <Grid  x:Name="PhoenicsPartialGrid1">
                                        <Grid.RowDefinitions>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="TBPG1_1"  Background="Lavender" Grid.Row="0"></TextBox>
                                        <TextBox x:Name="TBPG1_2"  Background="Lavender" Grid.Row="1"></TextBox>
                                        <TextBox x:Name="TBPG1_3"  Background="Lavender" Grid.Row="2"></TextBox>
                                        <TextBox x:Name="TBPG1_4"  Background="Lavender" Grid.Row="3"></TextBox>
                                        <TextBox x:Name="TBPG1_5"  Background="Lavender" Grid.Row="4"></TextBox>
                                        <TextBox x:Name="TBPG1_6"  Background="Lavender" Grid.Row="0" Grid.Column="1"></TextBox>
                                        <TextBox x:Name="TBPG1_7"  Background="Lavender" Grid.Row="1" Grid.Column="1"></TextBox>
                                        <TextBox x:Name="TBPG1_8"  Background="Lavender" Grid.Row="2" Grid.Column="1"></TextBox>
                                        <TextBox x:Name="TBPG1_9"  Background="Lavender" Grid.Row="3" Grid.Column="1"></TextBox>
                                        <TextBox x:Name="TBPG1_10" Background="Lavender" Grid.Row="4" Grid.Column="1"></TextBox>
                                    </Grid>
                                </Expander>
                                <Expander x:Name="PhoenicsPartialExpander2" Grid.Row="2" Header="其他標音2" Tag="2" Margin="8,0,0,0" Height="Auto" Visibility="Hidden" VerticalAlignment="Top" HorizontalAlignment="Left" Width="120" FontSize="15">
                                    <Grid  x:Name="PhoenicsPartialGrid2">
                                        <Grid.RowDefinitions>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="TBPG2_1"  Background="LightCyan" Grid.Row="0"></TextBox>
                                        <TextBox x:Name="TBPG2_2"  Background="LightCyan" Grid.Row="1"></TextBox>
                                        <TextBox x:Name="TBPG2_3"  Background="LightCyan" Grid.Row="2"></TextBox>
                                        <TextBox x:Name="TBPG2_4"  Background="LightCyan" Grid.Row="3"></TextBox>
                                        <TextBox x:Name="TBPG2_5"  Background="LightCyan" Grid.Row="4"></TextBox>
                                        <TextBox x:Name="TBPG2_6"  Background="LightCyan" Grid.Row="0" Grid.Column="1"></TextBox>
                                        <TextBox x:Name="TBPG2_7"  Background="LightCyan" Grid.Row="1" Grid.Column="1"></TextBox>
                                        <TextBox x:Name="TBPG2_8"  Background="LightCyan" Grid.Row="2" Grid.Column="1"></TextBox>
                                        <TextBox x:Name="TBPG2_9"  Background="LightCyan" Grid.Row="3" Grid.Column="1"></TextBox>
                                        <TextBox x:Name="TBPG2_10" Background="LightCyan" Grid.Row="4" Grid.Column="1"></TextBox>
                                    </Grid>
                                </Expander>
                                <Expander x:Name="PhoenicsPartialExpander3" Grid.Row="3" Header="其他標音3" Tag="3" Margin="8,0,0,0" Height="Auto" Visibility="Hidden" VerticalAlignment="Top" HorizontalAlignment="Left" Width="120" FontSize="15">
                                    <Grid  x:Name="PhoenicsPartialGrid3">
                                        <Grid.RowDefinitions>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="TBPG3_1"  Background="PapayaWhip" Grid.Row="0"></TextBox>
                                        <TextBox x:Name="TBPG3_2"  Background="PapayaWhip" Grid.Row="1"></TextBox>
                                        <TextBox x:Name="TBPG3_3"  Background="PapayaWhip" Grid.Row="2"></TextBox>
                                        <TextBox x:Name="TBPG3_4"  Background="PapayaWhip" Grid.Row="3"></TextBox>
                                        <TextBox x:Name="TBPG3_5"  Background="PapayaWhip" Grid.Row="4"></TextBox>
                                        <TextBox x:Name="TBPG3_6"  Background="PapayaWhip" Grid.Row="0" Grid.Column="1"></TextBox>
                                        <TextBox x:Name="TBPG3_7"  Background="PapayaWhip" Grid.Row="1" Grid.Column="1"></TextBox>
                                        <TextBox x:Name="TBPG3_8"  Background="PapayaWhip" Grid.Row="2" Grid.Column="1"></TextBox>
                                        <TextBox x:Name="TBPG3_9"  Background="PapayaWhip" Grid.Row="3" Grid.Column="1"></TextBox>
                                        <TextBox x:Name="TBPG3_10" Background="PapayaWhip" Grid.Row="4" Grid.Column="1"></TextBox>
                                    </Grid>
                                </Expander>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem x:Name="TabItemCharSearch" Header="字元搜尋" FontSize="15">
                <Grid Background="#FFE5E5E5">
                    <ScrollViewer x:Name="FilterScroll" Margin="0,0,345,0">
                        <Grid x:Name="SearchFilterGrid">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="1*"/>
                                <RowDefinition Height="1*"/>
                                <RowDefinition Height="1*"/>
                                <RowDefinition Height="1*"/>
                                <RowDefinition Height="1*"/>
                                <RowDefinition Height="1*"/>
                                <RowDefinition Height="1*"/>
                                <RowDefinition Height="1*"/>
                                <RowDefinition Height="1*"/>
                                <RowDefinition Height="1*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="42"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="SearchClearKXRDC" Grid.Column="1" Grid.Row="0" Content="清除" Click="SearchClearKXRDC_Click" FontSize="16"></Button>
                            <Button x:Name="SearchClearPT"    Grid.Column="1" Grid.Row="1" Content="清除" Click="SearchClearPT_Click" FontSize="16"></Button>
                            <Button x:Name="SearchClearSTKT"  Grid.Column="1" Grid.Row="2" Content="清除" Click="SearchClearSTKT_Click" FontSize="16"></Button>
                            <Button x:Name="SearchClearWX"    Grid.Column="1" Grid.Row="3" Content="清除" Click="SearchClearWX_Click" FontSize="16"></Button>
                            <Button x:Name="SearchClearFreq"  Grid.Column="1" Grid.Row="4" Content="清除" Click="SearchClearFreq_Click" FontSize="16"></Button>
                            <Button x:Name="SearchClearZone"  Grid.Column="1" Grid.Row="5" Content="清除" Click="SearchClearZone_Click" FontSize="16"></Button>
                            <Expander x:Name="SearchExpanderKXRDC" Grid.Row="0" MaxHeight="240" Margin="0,0,0,0" Header="康熙部首篩選" FontSize="20" Foreground="Black">
                                <ScrollViewer x:Name="SearchScrollKXRDC" VerticalScrollBarVisibility="visible" Margin="10,0,8,0">
                                    <WrapPanel x:Name="SearchPanelKXRDC" HorizontalAlignment="Center"/>
                                </ScrollViewer>
                            </Expander>
                            <Expander x:Name="SearchExpanderPT"    Grid.Row="1" MaxHeight="240" Margin="0,0,0,0" Header="漢字部件篩選" FontSize="20">
                                <ScrollViewer x:Name="SearchScrollPT" VerticalScrollBarVisibility="visible" Margin="10,0,8,0">
                                    <Grid x:Name="SearchGridPT">
                                        <Grid.RowDefinitions>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <Expander Header="康熙部首部件" Grid.Row="0">
                                            <WrapPanel x:Name="SearchPanelPTKXRDC" HorizontalAlignment="Center"/>
                                        </Expander>
                                        <Expander Header="一般部件" Grid.Row="1">
                                            <WrapPanel x:Name="SearchPanelPTNormal" HorizontalAlignment="Center"/>
                                        </Expander>
                                        <Expander Header="自定義部件" Grid.Row="2">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition/>
                                                    <RowDefinition/>
                                                </Grid.RowDefinitions>
                                                <WrapPanel x:Name="SearchPanelPTCustom" Grid.Row="0" HorizontalAlignment="Center"/>
                                                <Label Grid.Row="1" Content="手動輸入：" HorizontalAlignment="Left" Width="120"/>
                                                <TextBox x:Name="SearchPanelPTKeyIn" Grid.Row="1" Margin="120,0,0,0"/>
                                            </Grid>
                                        </Expander>
                                    </Grid>
                                </ScrollViewer>
                            </Expander>
                            <Expander x:Name="SearchExpanderSTKT"  Grid.Row="2" MaxHeight="240" Margin="0,0,0,0" Header="筆畫篩選" FontSize="20">
                                <ScrollViewer x:Name="SearchScrollSTKT" VerticalScrollBarVisibility="visible" Margin="10,0,8,0">
                                    <WrapPanel x:Name="SearchPanelSTKT" HorizontalAlignment="Center"/>
                                </ScrollViewer>
                            </Expander>
                            <Expander x:Name="SearchExpanderWX"    Grid.Row="3" MaxHeight="240" Margin="0,0,0,0" Header="五行篩選" FontSize="20">
                                <ScrollViewer x:Name="SearchScrollWX" VerticalScrollBarVisibility="visible" Margin="10,0,8,0">
                                    <WrapPanel x:Name="SearchPanelWX" HorizontalAlignment="Center"/>
                                </ScrollViewer>
                            </Expander>
                            <Expander x:Name="SearchExpanderFreq"  Grid.Row="4" MaxHeight="240" Margin="0,0,0,0" Header="頻率篩選" FontSize="20" >
                                <Grid x:Name="SearchPanelFreqGrid"  Margin="0,0,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="30"/>
                                        <RowDefinition Height="30"/>
                                        <RowDefinition Height="30"/>
                                        <RowDefinition Height="30"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="3*"/>
                                        <ColumnDefinition Width="1*"/>
                                    </Grid.ColumnDefinitions>
                                    <RadioButton x:Name="RadBtnD" Grid.Row="0" Content="無" IsChecked="True"/>
                                    <RadioButton x:Name="RadBtnA" Grid.Row="1" Content="通用" Tag="1"/>
                                    <RadioButton x:Name="RadBtnS" Grid.Row="2" Content="簡體" Tag="2"/>
                                    <RadioButton x:Name="RadBtnT" Grid.Row="3" Content="繁體" Tag="3"/>
                                    <Slider x:Name="SliderA" Maximum="13" Grid.Row="1" Grid.Column="1" Tag="1" VerticalAlignment="Center" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Text, ElementName=TextBoxA, Mode=TwoWay}" Margin="10,6" IsEnabled="{Binding IsChecked, ElementName=RadBtnA}"/>
                                    <Slider x:Name="SliderS" Maximum="7"  Grid.Row="2" Grid.Column="1" Tag="2" VerticalAlignment="Center" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Text, ElementName=TextBoxS, Mode=TwoWay}" Margin="10,6" IsEnabled="{Binding IsChecked, ElementName=RadBtnS}"/>
                                    <Slider x:Name="SliderT" Maximum="10" Grid.Row="3" Grid.Column="1" Tag="3" VerticalAlignment="Center" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Text, ElementName=TextBoxT, Mode=TwoWay}" Margin="10,6" IsEnabled="{Binding IsChecked, ElementName=RadBtnT}"/>
                                    <TextBox x:Name="TextBoxA" Grid.Row="1" Grid.Column="2" IsReadOnly="True" Text="13" IsEnabled="{Binding IsChecked, ElementName=RadBtnA}"/>
                                    <TextBox x:Name="TextBoxS" Grid.Row="2" Grid.Column="2" IsReadOnly="True" Text="7"  IsEnabled="{Binding IsChecked, ElementName=RadBtnS}"/>
                                    <TextBox x:Name="TextBoxT" Grid.Row="3" Grid.Column="2" IsReadOnly="True" Text="10" IsEnabled="{Binding IsChecked, ElementName=RadBtnT}"/>
                                </Grid>
                            </Expander>
                            <Expander x:Name="SearchExpanderZone"  Grid.Row="5" MaxHeight="240" Margin="0,0,0,0" Header="字區篩選" FontSize="20" >
                                <ScrollViewer x:Name="SearchScrollZone" VerticalScrollBarVisibility="visible" Margin="10,0,8,0">
                                    <WrapPanel x:Name="SearchPanelZone" HorizontalAlignment="Center"/>
                                </ScrollViewer>
                            </Expander>
                        </Grid>
                    </ScrollViewer>
                    <Grid x:Name="CharBlockGrid" Background="#FFD9D9D9" Height="330" Width="330" Margin="0,10,10,0" VerticalAlignment="Top" HorizontalAlignment="Right">
                        <WrapPanel x:Name="CharBlockPanel" Margin="0,6,0,0" HorizontalAlignment="Center">
                        </WrapPanel>
                    </Grid>
                    <Grid x:Name="CharBlockActions" Margin="0,345,10,10" HorizontalAlignment="Right" Width="330">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1*"/>
                            <RowDefinition Height="1*"/>
                            <RowDefinition Height="2*"/>
                        </Grid.RowDefinitions>
                        <Slider  Grid.Row="0" x:Name="CharBlockSlider" Margin="0,6,0,0" VerticalAlignment="Top" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Text, ElementName=CharBlockTextBox}" HorizontalAlignment="Right" Width="188" ValueChanged="CharBlockSlider_ValueChanged"/>
                        <TextBox Grid.Row="0" x:Name="CharBlockTextBox" Height="23" Margin="81,4,0,0" TextWrapping="Wrap" VerticalAlignment="Top" TextAlignment="Right" Text="{Binding Value, ElementName=CharBlockSlider}" HorizontalAlignment="Left" Width="56"/>
                        <Label   Grid.Row="0" Content="字元頁數：" Margin="0,0,249,0"/>
                        <Button  Grid.Row="1" x:Name="QueryExecute" Content="查詢" VerticalAlignment="Top" Click="QueryExecute_Click" HorizontalAlignment="Left" Width="72"/>
                        <Button  Grid.Row="1" x:Name="OutputExecute" Content="輸出" Margin="81,0,0,0" Click="OutputExecute_Click" Height="23" VerticalAlignment="Top" HorizontalAlignment="Left" Width="72" />
                        <Expander Grid.Row="2" Header="搜尋紀錄" x:Name="SearchHistory" IsExpanded="True">
                            <WrapPanel x:Name="SearchHistoryWrapPanel">

                            </WrapPanel>
                        </Expander>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem x:Name="TabItemOutput" Header="輸出" FontSize="15">
                <Grid>
                    <Grid Margin="10" Background="LightSteelBlue">
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <ScrollViewer>
                            <TextBox x:Name="OutputTextBox" TextWrapping="Wrap" Text="" Margin="10" FontSize="30"/>
                        </ScrollViewer>
                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Grid HorizontalAlignment="Left" VerticalAlignment="Top" Height="80" Width="108" Margin="10,10,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.RowSpan="3" Grid.ColumnSpan="2" Content="狼" FontSize="48" Background="#FFEFFF52" FontFamily="Segoe UI Black" Visibility="Hidden"></Button>
                                <Button Grid.Row="0" Grid.Column="2" FontSize="18" Content="9" FontFamily="Segoe UI Black" Visibility="Hidden"/>
                                <Button Grid.Row="0" Grid.Column="3" FontSize="18" Content="13" FontFamily="Segoe UI Black" Visibility="Hidden"/>
                                <Button Grid.Row="1" Grid.Column="2" FontSize="18" Content="犬" FontFamily="Segoe UI Black" Visibility="Hidden"/>
                                <Button Grid.Row="1" Grid.Column="3" FontSize="18" Content="普" FontFamily="Segoe UI Black" Visibility="Hidden"/>
                                <Button Grid.ColumnSpan="2" Grid.Row="2" Grid.Column="2" FontSize="18" Content="U" FontFamily="Segoe UI Black" Visibility="Hidden"/>
                            </Grid>
                            <Grid HorizontalAlignment="Left" VerticalAlignment="Top" Height="64" Width="96" Margin="10,10,0,0" Grid.Row="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="金" FontSize="18" FontFamily="Segoe UI Black" Background="#FFEFFF52" Visibility="Hidden"></Button>
                                <Button Grid.Column="1" Content="木" FontSize="18" FontFamily="Segoe UI Black" Background="#FFA1FF7E" Visibility="Hidden"></Button>
                                <Button Grid.Column="2" Content="水" FontSize="18" FontFamily="Segoe UI Black" Background="#FF50FFF7" Visibility="Hidden"></Button>
                                <Button Grid.Column="0" Grid.Row="1" Content="火" FontSize="18" FontFamily="Segoe UI Black" Background="#FFFF9797" Visibility="Hidden"></Button>
                                <Button Grid.Column="1" Grid.Row="1" Content="土" FontSize="18" FontFamily="Segoe UI Black" Background="#FFD199FF" Visibility="Hidden"></Button>
                                <Button Grid.Column="2" Grid.Row="1" Content="?" FontSize="18" FontFamily="Segoe UI Black" Background="#FFB4B4B4" Visibility="Hidden"></Button>
                            </Grid>
                            <Grid HorizontalAlignment="Left" VerticalAlignment="Top" Height="64" Width="96" Margin="10,10,0,0" Grid.Column="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                            </Grid>
                        </Grid>

                    </Grid>
                </Grid>
            </TabItem>
            <!--除錯Tab永遠放在最後端-->
            <TabItem x:Name="TabItemDebug" Header="除錯" FontSize="15" Visibility="Hidden">
                <Grid Background="DarkRed">
                    <Grid Margin="10" Background="Ivory">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1*"/>
                            <RowDefinition Height="3*"/>
                            <RowDefinition Height="1*"/>
                        </Grid.RowDefinitions>
                        <Expander Grid.Row="0" Header="查詢速度測試" IsExpanded="True">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="DebugSearchAllDataOneTime" Grid.Row="0" Content="取得所有字所有資料"/>
                                <Button x:Name="DebugSearchAllDataDiffChar10" Grid.Row="1" Content="取得10個單個不同字所有資料"/>
                                <Button x:Name="DebugSearchAllDataRadiChar" Grid.Row="0" Grid.Column="1" Content="取得特定部首字所有資料"/>
                                <Button x:Name="DebugSearchAllDataSearch100" Grid.Row="1" Grid.Column="1" Content="連續查詢100次不同單字"/>
                            </Grid>
                        </Expander>
                        <Expander Grid.Row="1" Header="資料庫資訊" IsExpanded="True">
                            <TextBlock x:Name="DebugDatabaseDetail" Text="資料庫細節"></TextBlock>
                        </Expander>
                        <Expander Grid.Row="2" Header="其他" IsExpanded="True">
                            <Button Content="Button" HorizontalAlignment="Left" Margin="10,0,0,0" VerticalAlignment="Top" Width="75" Click="Button_Click"/>
                        </Expander>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem x:Name="TabItemCharBlocks" Header="新字元顯示" FontSize="15" Visibility="Hidden">
                <Grid x:Name="GridCharBlocks"/>
            </TabItem>


        </TabControl>

        <StackPanel Height="23" Margin="10,10,10,0" VerticalAlignment="Top">
            <Menu x:Name="MenuBase">
                <MenuItem x:Name="MenuSettings" Header="(_S)設定" FontSize="15">
                    <MenuItem x:Name ="MenuDataBaseAvaliable" Header="(_R)目前可用資料庫" IsEnabled="False">
                        <!--自動生成的可選資料庫選項會放在這裡，不需特別新增-->
                    </MenuItem>
                    <MenuItem x:Name="MenuOptions" Header="(_O)選項" Click="Menu_Option_Click"/>
                    <MenuItem x:Name="MenuExit" Header="(_E)離開" Click="Menu_Exit_Click"/>
                </MenuItem>
                <MenuItem x:Name="MenuFunctions" Header="(_O)功能" FontSize="15">
                    <MenuItem x:Name="MenuHighLightFontChar" Header="醒目字型適用字" IsCheckable="False" IsChecked="False" Checked="Menu_HighLightFontChar_Checked" Unchecked="Menu_HighLightFontChar_Unchecked"></MenuItem>
                </MenuItem>
                <MenuItem x:Name="MenuInformation" Header="(_H)說明" FontSize="15">
                    <MenuItem x:Name="MenuAbout" Header="(_A)關於" Click="Menu_About_Click"/>
                </MenuItem>
            </Menu>
        </StackPanel>
        <StatusBar  Margin="10,0,10,10" Height="29" VerticalAlignment="Bottom">
            <!--DataContext="{StaticResource VersionViewSource}"-->
            <TextBox x:Name="VersionText" Text="Data Version:" IsEnabled="False"/>
            <Label x:Name="VER_ALabel" Content="{Binding VER_A}" Grid.Column="1" HorizontalAlignment="Left" Grid.Row="0" VerticalAlignment="Top" FontSize="9" Width="15" Height="20" Margin="0" Opacity="0"/>
            <Label x:Name="VER_BLabel" Content="{Binding VER_B}" Grid.Column="1" HorizontalAlignment="Left" Grid.Row="0" VerticalAlignment="Top" FontSize="9" Width="15" Height="20" Margin="0" Opacity="0"/>
            <Label x:Name="VER_CLabel" Content="{Binding VER_C}" Grid.Column="1" HorizontalAlignment="Left" Grid.Row="0" VerticalAlignment="Top" FontSize="9" Width="15" Height="20" Margin="0" Opacity="0"/>
            <TextBox x:Name="StatusText" Text="最後動作：無" IsEnabled="False" Foreground="Navy"/>
            <TextBox x:Name="ErrText" Text="錯誤：無" IsEnabled="False" Foreground="Red"/>
        </StatusBar>
        <StackPanel Background="Azure" HorizontalAlignment="Left"  Margin="10,33,0,393" Width="150">
            <TextBox x:Name="C_CHARTextBox" DataContext="{StaticResource charXViewSource}" IsReadOnly="false" Height="140" Text="{Binding C_CHAR, Mode=TwoWay, NotifyOnValidationError=true, ValidatesOnExceptions=true}" VerticalAlignment="Center" DockPanel.Dock="Top" FontSize="120" TextAlignment="Center" FontFamily="MingLiU" TextChanged="C_CHARTextBox_TextChanged"/>
            <Grid x:Name="Grid4" DataContext="{StaticResource charXViewSource}" HorizontalAlignment="Left" Margin="0,5,0,0" Width="140" Height="47" VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                </Grid.RowDefinitions>
                <Label Content="UniDec" Grid.Column="0" Margin="0,0,0,0" Grid.Row="0" VerticalAlignment="Top" Height="29" HorizontalContentAlignment="Center" FontSize="15"/>
                <Label Content="UniHex" Grid.Column="1" Margin="0,0,0,0" Grid.Row="0" VerticalAlignment="Top" Height="29" HorizontalContentAlignment="Center" FontSize="15"/>
                <TextBox x:Name="C_UDECTextBox" Grid.Row="1" Grid.Column="0" IsReadOnly="True"  DataContext="{StaticResource charXViewSource}" Height="23" Margin="0,0,0,0" Text="{Binding C_UDEC, Mode=TwoWay, NotifyOnValidationError=true, ValidatesOnExceptions=true}" Width="69" HorizontalContentAlignment="Center" FontSize="15" TextChanged="C_UDECTextBox_TextChanged"/>
                <TextBox x:Name="C_UHEXTextBox" Grid.Row="1" Grid.Column="1" IsReadOnly="True" Height="23" Margin="0,0,0,0" TextWrapping="Wrap" Width="66" HorizontalContentAlignment="Center" FontSize="15"/>
            </Grid>
            <Grid x:Name="Grid5" DataContext="{StaticResource charXViewSource}" HorizontalAlignment="Left" Margin="0,5,0,0" Width="140" Height="92" VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                </Grid.RowDefinitions>
                <Label Content="部首" Grid.Column="0" HorizontalAlignment="Left" Margin="3,0,0,0" Grid.Row="0" Width="55" FontSize="15"/>
                <Label Content="五行" Grid.Column="0" HorizontalAlignment="Left" Margin="3,0,0,0" Grid.Row="1" Width="55" FontSize="15"/>
                <Label Content="筆畫" Grid.Column="0" HorizontalAlignment="Left" Margin="3,0,0,0" Grid.Row="2" Width="55" FontSize="15"/>
                <TextBox x:Name="C_RDCNTextBox"     IsReadOnly="True" Grid.Row="0" Grid.Column="1" Height="24" Width="30" Text="{Binding C_RDCN, Mode=TwoWay, NotifyOnValidationError=true, ValidatesOnExceptions=true}" FontSize="15"/>
                <TextBox x:Name="C_RDCNTextBox_RDC" IsReadOnly="True" Grid.Row="0" Grid.Column="2" Height="24" Width="30" Text="" FontSize="15"/>
                <TextBox x:Name="C_WXTextBox"       IsReadOnly="True" Grid.Row="1" Grid.Column="1" Height="24" Width="30" Text="{Binding C_WX, Mode=TwoWay, NotifyOnValidationError=true, ValidatesOnExceptions=true}" FontSize="15" TextChanged="C_WXTextBox_TextChanged"/>
                <TextBox x:Name="C_WXTextBox_WX"    IsReadOnly="True" Grid.Row="1" Grid.Column="2" Height="24" Width="30" FontSize="15" ></TextBox>
                <TextBox x:Name="C_STKOTextBox"     IsReadOnly="True" Grid.Row="2" Grid.Column="1" Height="24" Width="30" Text="{Binding C_STKO, Mode=TwoWay, NotifyOnValidationError=true, ValidatesOnExceptions=true}" FontSize="15" />
                <TextBox x:Name="C_STKTTextBox"     IsReadOnly="True" Grid.Row="2" Grid.Column="2" Height="24" Width="30"  Text="{Binding C_STKT, Mode=TwoWay, NotifyOnValidationError=true, ValidatesOnExceptions=true}" FontSize="15"/>
            </Grid>

        </StackPanel>
        <StackPanel Background="Azure" Margin="10,330,0,104" HorizontalAlignment="Left" Width="150">
            <ScrollViewer Margin="0">
                <TreeView x:Name="TrvMenu" Background="Bisque" FontSize="24" SelectedItemChanged="TrvMenu_SelectedItemChanged">
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate DataType="{x:Type MenuItem}" ItemsSource="{Binding Items}">
                            <TextBlock Text="{Binding Title}" />
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>                
            </ScrollViewer>
            <ToggleButton x:Name="TrvExtendBtn" Content="全部展開/收合" Click="TrvExtendBtn_Click" Checked="TrvExtendBtn_Checked"></ToggleButton>
        </StackPanel>
        <DockPanel Margin="10,0,10,44" Background="Bisque" Height="55" VerticalAlignment="Bottom" >
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid Margin="10,0,10,0">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32"/>
                        <ColumnDefinition Width="32"/>
                        <ColumnDefinition Width="32"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="32"/>
                        <ColumnDefinition Width="32"/>
                        <ColumnDefinition Width="32"/>
                        <ColumnDefinition Width="32"/>
                        <ColumnDefinition Width="7*"/>
                    </Grid.ColumnDefinitions>
                    <Button  Grid.Column="0" x:Name="MoveFirst"         Click="MoveFirst_Click"         Width="32" DockPanel.Dock="Left" Height="23" Content="|◀"/>
                    <Button  Grid.Column="1" x:Name="MovePreviousLarge" Click="MovePreviousLarge_Click" Width="32" DockPanel.Dock="Left" Height="23" Content="◀◀"/>
                    <Button  Grid.Column="2" x:Name="MovePrevious"      Click="MovePrevious_Click"      Width="32" DockPanel.Dock="Left" Height="23" Content="◀"/>
                    <TextBox Grid.Column="3" x:Name="C_IDTextBox"       Height="23" FontSize="15" Text="{Binding C_ID, Mode=TwoWay, NotifyOnValidationError=true, ValidatesOnExceptions=true}"/>
                    <TextBox Grid.Column="4" x:Name="C_IDTextBox_Count" Height="23" FontSize="15" IsEnabled="False" TextWrapping="Wrap" Text="9999"/>
                    <Button  Grid.Column="5" x:Name="MoveNext"          Click="MoveNext_Click"          Width="32" DockPanel.Dock="Left" Height="23" Content="▶"/>
                    <Button  Grid.Column="6" x:Name="MoveNextLarge"     Click="MoveNextLarge_Click"     Width="32" DockPanel.Dock="Left" Height="23" Content="▶▶"/>
                    <Button  Grid.Column="7" x:Name="MoveLast"          Click="MoveLast_Click"          Width="32" DockPanel.Dock="Left" Height="23" Content="▶|"/>
                    <Button  Grid.Column="8" x:Name="DataSave"          Height="23" Width="32" DockPanel.Dock="Left" IsEnabled="False" Content="存"/>
                    <Slider  Grid.Column="9" x:Name="CharSlider"        IsSnapToTickEnabled="True" LargeChange="10" Minimum="1" MaxWidth="500" ValueChanged="CharSlider_ValueChanged" Value="{Binding Text, ElementName=C_IDTextBox}" Maximum="{Binding Text, ElementName=C_IDTextBox_Count, StringFormat=\{0:F0\}}" />
                </Grid>
            </Grid>
        </DockPanel>
    </Grid>


</Window>
